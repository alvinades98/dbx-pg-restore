{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/plugin-sdk-v1/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "alvinades98.pg-backup-restore",
  "name": "PG Backup & Restore",
  "version": "0.3.0",
  "publisher": "alvinades98",
  "description": "Back up and restore PostgreSQL databases (custom, tar, directory or plain SQL) using pg_dump / pg_restore / psql.",
  "icon": "assets/plugin.png",
  "source": "https://github.com/alvinades98/dbx-pg-restore",
  "engines": {
    "dbx": ">=0.6.15",
    "host_api": "1"
  },
  "permissions": [
    "host.storage"
  ],
  "entrypoints": {
    "backend": {
      "executable": "bin/dbx-pg-restore"
    },
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "workbench",
      "id": "alvinades98.pg-backup-restore.workbench",
      "label": "PG Backup & Restore",
      "description": "Back up or restore a PostgreSQL database.",
      "icon": "assets/plugin.png"
    },
    {
      "type": "context-menu",
      "id": "alvinades98.pg-backup-restore.open",
      "label": "Backup / restore PostgreSQL…",
      "menu": "connection",
      "action": {
        "type": "open-workbench",
        "workbench": "alvinades98.pg-backup-restore.workbench"
      }
    }
  ],
  "localizations": {
    "id": {
      "description": "Backup dan restore database PostgreSQL (custom, tar, direktori, atau SQL biasa) memakai pg_dump / pg_restore / psql.",
      "contributions": {
        "alvinades98.pg-backup-restore.workbench": {
          "label": "PG Backup & Restore",
          "description": "Backup atau restore database PostgreSQL."
        },
        "alvinades98.pg-backup-restore.open": {
          "label": "Backup / restore PostgreSQL…"
        }
      }
    },
    "zh-CN": {
      "name": "PG 备份与恢复",
      "description": "使用 pg_dump / pg_restore / psql 备份和恢复 PostgreSQL 数据库（custom、tar、目录或纯 SQL 格式）。",
      "contributions": {
        "alvinades98.pg-backup-restore.workbench": {
          "label": "PG 备份与恢复",
          "description": "备份或恢复 PostgreSQL 数据库。"
        },
        "alvinades98.pg-backup-restore.open": {
          "label": "备份 / 恢复 PostgreSQL…"
        }
      }
    }
  }
}
